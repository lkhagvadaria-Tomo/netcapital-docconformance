# Copy to .env.local and fill in with a real Supabase project to leave
# mock mode. Never commit the real .env.local (see .gitignore).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" forces the manual user picker even if Supabase vars above are set
# (useful for demoing without touching real data). Leave unset in production.
VITE_AUTH_MODE=

# Only used server-side, by tests/phase1-rls.test.ts and the Supabase CLI —
# never exposed to the browser bundle (no VITE_ prefix). Get it from
# Supabase project settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client used by supabase/config.toml when running the CLI's
# local stack (`supabase start`) — not read by the web app directly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
