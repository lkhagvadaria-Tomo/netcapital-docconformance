# Copy to .env.local and fill in with a real Supabase project to leave
# mock mode. Never commit the real .env.local (see .gitignore).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "mock" forces the manual user picker even if Supabase vars above are set
# (useful for demoing without touching real data). Leave unset in production.
VITE_AUTH_MODE=

# Read by tests/phase1-rls.test.ts (via tests/setup.ts, which loads
# .env.local for Node/vitest — Vite's own VITE_-prefixed loading above is
# separate and only for the browser app). Same project as the VITE_ vars
# above; SUPABASE_URL/SUPABASE_ANON_KEY are just the non-VITE_-prefixed
# spelling Node reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only used server-side (tests, the Supabase CLI) — never exposed to the
# browser bundle (no VITE_ prefix). Get it from Supabase project settings →
# API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client used by supabase/config.toml when running the CLI's
# local stack (`supabase start`) — not read by the web app directly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# NOT read from this file. The extract-rules Edge Function reads it from
# its own deployed environment — set it with:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Listed here only so it's not a mystery where Phase 2's AI rule extraction
# gets its credential from.
# ANTHROPIC_API_KEY=
